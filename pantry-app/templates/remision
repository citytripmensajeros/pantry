{% extends "base.html" %}
{% block title %}Remisión {{ pedido.numero }} — CityPantry{% endblock %}
{% block content %}
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:.5rem;">
  <h1 style="font-size:1.3rem; color:var(--azul);">Remisión — Pedido {{ pedido.numero }}</h1>
  <div class="gap">
    <a class="btn btn-secondary" href="/pedidos/{{ pedido.id }}">← Regresar</a>
    <button class="btn btn-primary" onclick="window.print()">🖨 Imprimir</button>
  </div>
</div>

<div id="remision-print">
  <div class="remision-header">
    <div class="remision-logo">
      <img src="data:image/png;base64," alt="Citytrip" style="height:60px;">
    </div>
    <div class="remision-meta">
      <div class="remision-fecha">{{ pedido.fecha }}</div>
      <div class="remision-tipo">REMISIÓN</div>
      <div class="remision-cliente">{{ pedido.cliente_nombre }}</div>
    </div>
  </div>

  <table class="remision-table">
    <thead>
      <tr>
        <th class="col-ctd">Ctd</th>
        <th class="col-prod">Producto</th>
      </tr>
    </thead>
    <tbody>
      {% for item in items %}
      <tr>
        <td class="col-ctd">{{ item.cantidad|int if item.cantidad == item.cantidad|int else item.cantidad }}</td>
        <td class="col-prod">{{ item.producto_nombre }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="remision-footer">
    <div class="firma-line"></div>
    <div class="firma-label">Firma de recibido</div>
  </div>
</div>
{% endblock %}
{% block scripts %}
<style>
  #remision-print {
    background: #fff;
    max-width: 600px;
    margin: 0 auto;
    padding: 2rem;
    border: 1px solid var(--borde);
    border-radius: 12px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .remision-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #0F51B0;
  }

  .remision-logo img { height: 55px; }

  .remision-meta { text-align: right; }

  .remision-fecha {
    font-size: .85rem;
    color: #555;
    margin-bottom: .2rem;
  }

  .remision-tipo {
    font-size: 1.3rem;
    font-weight: 800;
    color: #111;
    letter-spacing: 2px;
    margin-bottom: .25rem;
  }

  .remision-cliente {
    font-size: 1rem;
    font-weight: 700;
    color: #0F51B0;
  }

  .remision-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2.5rem;
    font-size: .92rem;
  }

  .remision-table thead tr {
    background: #f0f5ff;
  }

  .remision-table th {
    padding: .55rem .75rem;
    text-align: left;
    font-weight: 700;
    color: #0F51B0;
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .5px;
    border: 1px solid #c5d4f0;
  }

  .remision-table td {
    padding: .5rem .75rem;
    border: 1px solid #dde3f0;
    vertical-align: middle;
  }

  .remision-table tbody tr:nth-child(even) {
    background: #f9fbff;
  }

  .col-ctd { width: 50px; text-align: center; }
  .col-prod { }

  .remision-footer {
    margin-top: 3rem;
    text-align: center;
  }

  .firma-line {
    width: 60%;
    margin: 0 auto 0.4rem;
    border-bottom: 1.5px solid #333;
  }

  .firma-label {
    font-size: .8rem;
    color: #0F51B0;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Print styles */
  @media print {
    nav, .page-header, .gap, h1, .btn, .flash, .container > *:not(#remision-print) { display: none !important; }
    body { background: #fff; }
    .container { padding: 0; max-width: 100%; }
    #remision-print {
      border: none;
      border-radius: 0;
      padding: 1.5cm 2cm;
      max-width: 100%;
      margin: 0;
    }
  }
</style>
{% endblock %}
